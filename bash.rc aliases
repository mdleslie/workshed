################################################################################################
###### Add to the end of the .bashrc file located user directory. ##############################
################################################################################################

# Startup Greeting
figlet Workshed | lolcat -a -d 3

# ─── PACKAGE MANAGEMENT ───
alias i='sudo nala install'
alias fetch='sudo nala fetch'
alias update='update.sh | lolcat' 
alias fix='sudo apt --fix-broken install'

# ─── SYSTEM & SAFETY ───
alias cp='cp -vi'
alias mv='mv -vi'
alias rm='rm -i'
alias mkdir='mkdir -pv'
alias bashrc="nano ~/.bashrc"
alias reload="source ~/.bashrc"

# ─── NAVIGATION & LISTING ───
alias ..="cd .."
alias cd..="cd .."
alias ...="cd ../../"
alias ....="cd ../../../"
alias ll='ls -alF --color=auto'
alias la='ls -A --color=auto'
alias l='ls -CF --color=auto'

# ─── UTILITIES ───
alias extip='curl icanhazip.com'
alias parrot='curl parrot.live'
alias speedtest='curl -s https://raw.githubusercontent.com/sivel/speedtest-cli/master/speedtest.py | python3 -'
alias mem5='ps auxf | sort -nr -k 4 | head -5'
alias ports='sudo netstat -tulanp'  # Requires net-tools, showing listening ports

# ─── DISK & FILE TOOLS ───
alias wget='wget -c'
alias cpv='rsync -avh --info=progress2'
alias usage='ncdu'          # Changed from 'du' to prevent breakage
alias pydf='pydf'           # Kept pydf separate from df just in case
alias catt='cat | lolcat'   # Changed from 'cat' to prevent pipe corruption
alias store='arkive_files.sh'

# ─── MEDIA & SERVER ───
# Changed browser to chrome (since you install it). Change back if you use Firefox.
alias yt='yt-dlp --cookies-from-browser chrome' 

# Docker Shortcuts (For Arr Stack)
alias dps='docker ps --format "table {{.ID}}\t{{.Names}}\t{{.Status}}\t{{.Ports}}"'
alias dcompose='docker compose'
alias dlogs='docker logs -tf --tail="50" '

# ─── AESTHETICS ───
# Place maid logo in ~/.local/share/fastfetch/logos/maid
alias fastfetch='fastfetch -l maid | lolcat'

# Nice username colors
export PS1='\[\e[0;36m\]\u\[\e[0m\]@\[\e[0;32m\]\h\[\e[0m\]:\[\e[0;34m\]\w\[\e[0m\]> '

# ─── SSH SHORTCUTS ───
alias merlin="ssh david@192.168.1.100 -p 42"
alias arkive="ssh david@192.168.1.150 -p 42"
alias arr="ssh david@192.168.1.2"

# ─── FUNCTIONS ───

# Sudo the last command (The "Fuck" command)
fuck() {
    if [[ $# == 0 ]]; then
        sudo $(history -p '!!')
    else
        sudo "$@"
    fi
}

# Extract any archive
extract () {
  if [ -f $1 ] ; then
    case $1 in
      *.tar.bz2)   tar xjf $1     ;;
      *.tar.gz)    tar xzf $1     ;;
      *.bz2)       bunzip2 $1     ;;
      *.rar)       unrar e $1     ;;
      *.gz)        gunzip $1      ;;
      *.tar)       tar xf $1      ;;
      *.tbz2)      tar xjf $1     ;;
      *.tgz)       tar xzf $1     ;;
      *.zip)       unzip $1       ;;
      *.Z)         uncompress $1  ;;
      *.7z)        7z x $1        ;;
      *)     echo "'$1' cannot be extracted via extract()" ;;
    esac
  else
    echo "'$1' is not a valid file"
  fi
}
